# Listen address
PICTOR_HOST=127.0.0.1
PICTOR_PORT=8091

# Hugging Face repo (downloaded to the HF cache on first start, ~33 GB)
PICTOR_MODEL_ID=Qwen/Qwen-Image-2.1

# Device: auto (cuda > mps > cpu), cuda, mps, cpu
PICTOR_DEVICE=auto
# CUDA only: none | int8 | fp8 (torchao weight-only quantization of the transformer)
PICTOR_QUANT=none
# CUDA only: keep idle sub-models in host RAM (fits 24 GB cards)
PICTOR_CPU_OFFLOAD=false

# Load the weights at start (true) or on the first request (false)
PICTOR_PRELOAD=true
# Unload after N seconds without a job (0 = never); reload takes ~20 s
PICTOR_IDLE_UNLOAD_S=900

# Generation defaults (Qwen recommends 40 steps; 20 halves the wait, ~10 s/step at 1024² on an M4 Pro)
PICTOR_DEFAULT_WIDTH=1024
PICTOR_DEFAULT_HEIGHT=1024
PICTOR_DEFAULT_STEPS=20
PICTOR_DEFAULT_GUIDANCE=1.0
PICTOR_MAX_SIDE=2048
